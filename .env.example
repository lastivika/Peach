# --- database ---
POSTGRES_USER=peach
POSTGRES_PASSWORD=peach
POSTGRES_DB=peach
POSTGRES_PORT=5432

# --- backend ---
DATABASE_URL=postgresql+asyncpg://peach:peach@db:5432/peach
BACKEND_PORT=8000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# --- frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# --- aws (make deploy-backend / deploy-frontend / domain) ---
# Everything lands in us-east-1, tagged PROJECT_NAME=<PROJECT_NAME>. Every
# other knob has a default in the scripts or templates and can still be set
# here to override it.
AWS_REGION=us-east-1
PROJECT_NAME=peach
# Blank keys fall back to AWS_PROFILE, SSO, or an instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=

# The deployed frontend's origin, once it has one.
API_CORS_ORIGINS=

# --- written by the scripts, not by hand ---
# make deploy-backend: the HTTPS API domain. make deploy-frontend builds against it.
BACKEND_URL=
# make domain DOMAIN=app.example.com: the frontend's custom domain.
DOMAIN_NAME=

# --- ECS lab deployment ---
# Use your non-root IAM profile; never commit access keys.
# Existing Aurora stack (created by the earlier Lambda deployment).
DATABASE_STACK_NAME=peach-backend
API_DOMAIN_NAME=
API_CERTIFICATE_ARN=
# Optional Route 53 zone: empty means add the API routing CNAME manually.
API_HOSTED_ZONE_ID=
# Explicitly your own GitHub repository, not the starter's origin.
GITHUB_REPO=
# Optional public subnet IDs, comma-separated, in at least two AZs.
AWS_SUBNET_IDS=
AWS_VPC_ID=
